# Copy to .env.local (gitignored). Local development only.

# Skip login/register on localhost — production is unchanged.
DEV_BYPASS_AUTH=true
NEXT_PUBLIC_DEV_BYPASS_AUTH=true

# Optional: auto sign-in so Dashboard / Plan / Workout load your data.
# Create this user once in Supabase Dashboard → Authentication → Users → Add user
# (do not use the app's Register page unless you want to test that flow).
# DEV_EMAIL=you@example.com
# DEV_PASSWORD=your-dev-password
